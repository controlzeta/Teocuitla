@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Inherit" Class="border-b border-solid mud-border-default">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6" Class="ml-3 font-bold" Style="font-family: 'Outfit', sans-serif;">
            TEOCUITLA
            <span style="font-size: 0.75rem; font-weight: 500; opacity: 0.6; margin-left: 6px; letter-spacing: 0.5px;">v@(Teocuitla.Shared.AppVersion.Version)</span>
        </MudText>
        <MudSpacer />
        <MudToggleIconButton @bind-Toggled="@_isDarkMode"
                             Icon="@Icons.Material.Filled.LightMode" Color="Color.Warning"
                             ToggledIcon="@Icons.Material.Filled.DarkMode" ToggledColor="Color.Info" />
    </MudAppBar>
    
    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="@DrawerVariant.Responsive" Class="border-r border-solid mud-border-default">
        <MudNavMenu>
            <MudText Typo="Typo.subtitle2" Class="px-4 pt-3 pb-2 text-muted font-bold" Style="font-family: 'Outfit', sans-serif;">MONITOR</MudText>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Panel General</MudNavLink>
            <MudNavLink Href="/catalogo" Icon="@Icons.Material.Filled.ShoppingBag">Catálogo</MudNavLink>
            <MudNavLink Href="/sitios" Icon="@Icons.Material.Filled.SettingsInputComponent">Configuración Sitios</MudNavLink>
            <MudNavLink Href="/proxies" Icon="@Icons.Material.Filled.VpnLock">Registro Proxies</MudNavLink>
            <MudNavLink Href="/admin/logs" Icon="@Icons.Material.Filled.ReceiptLong">Historial de Logs</MudNavLink>
            <MudNavLink Href="/admin/fallas" Icon="@Icons.Material.Filled.BugReport">Diagnóstico de Fallas</MudNavLink>
            <MudNavLink Href="/admin/extractor-categorias" Icon="@Icons.Material.Filled.ManageSearch">Extractor de Categorías</MudNavLink>
        </MudNavMenu>
        <MudSpacer />
        <div class="pa-4 border-t border-solid mud-border-default text-center">
            <MudText Typo="Typo.caption" Class="text-muted font-medium">Teocuitla v@(Teocuitla.Shared.AppVersion.Version)</MudText>
        </div>
    </MudDrawer>

    <MudMainContent Class="mud-background-gray">
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true; // Por defecto modo oscuro AMOLED

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private readonly MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#B8860B",       // Oro Oscuro Satinado
            Secondary = "#475569",     // Titanio Slate
            AppbarBackground = "#FFFFFF",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            TextPrimary = "#0F172A",
            TextSecondary = "#475569",
            Divider = "#E2E8F0",
            TableLines = "#E2E8F0",
            LinesDefault = "#E2E8F0"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#D4AF37",          // Oro Champán Teocuitla
            Secondary = "#94A3B8",        // Titanio Mate
            Success = "#10B981",          // Esmeralda Sobrio
            Warning = "#F59E0B",          // Ámbar Cálido
            Error = "#E11D48",            // Carmín Rosa
            AppbarBackground = "#121418", // Obsidian Surface 0
            Background = "#0B0C0E",       // Obsidian Base Dark
            Surface = "#121418",          // Obsidian Surface 0
            DrawerBackground = "#121418", // Obsidian Surface 0
            TextPrimary = "#F4F4F5",
            TextSecondary = "#94A3B8",
            Divider = "#1F232B",          // Border Slate
            TableLines = "#1F232B",
            LinesDefault = "#1F232B",
            ActionDefault = "#94A3B8"
        },


        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "12px"
        }
    };
}
