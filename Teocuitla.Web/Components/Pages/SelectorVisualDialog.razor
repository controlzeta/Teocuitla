@implements IDisposable
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <div class="d-flex flex-column gap-3" style="min-height: 80vh;">
            
            <!-- ENCABEZADO DE SELECTOR ACTIVO -->
            <div class="d-flex align-center gap-2 px-3 py-2 rounded border border-solid mud-border-default" style="background: var(--mud-palette-surface);">
                <MudIcon Icon="@Icons.Material.Filled.TouchApp" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.subtitle1" Class="font-bold text-primary" Style="font-family: 'Outfit', sans-serif;">
                    Configurando: <span class="mud-text-secondary font-weight-regular" style="font-weight: 400; opacity: 0.85;">@FieldName</span>
                </MudText>
            </div>
            
            <!-- PANEL DE CONTROL SUPERIOR -->
            <MudPaper Outlined="true" Class="pa-4 border border-solid mud-border-default" Style="background: var(--mud-palette-surface);">
                <MudGrid Spacing="2" Class="align-center">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_testUrl" 
                                       Label="URL de Prueba del Producto" 
                                       Placeholder="Pega un enlace del producto para extraer sus selectores..."
                                       Variant="Variant.Outlined" 
                                       Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" Class="d-flex gap-2 align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudDownload" OnClick="CargarPaginaProxy" Style="flex-grow: 1;">
                            Cargar Vista
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ContentPaste" OnClick="ToggleManualHtmlPanel">
                            Pegar HTML
                        </MudButton>
                        @if (_loadingPage)
                        {
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                        }
                    </MudItem>
                </MudGrid>

                @if (_showManualHtmlPanel)
                {
                    <div class="mt-3 pa-3 border border-dashed rounded mud-border-default" style="background: var(--mud-palette-background-grey);">
                        <MudText Typo="Typo.subtitle2" Class="mb-1 font-bold">Carga de HTML Manual (Fallback)</MudText>
                        <MudText Typo="Typo.body2" Class="text-muted mb-2">
                            Si el sitio bloquea la carga automatizada, abre el producto en tu navegador, copia el código fuente HTML completo (Ctrl+U) y pégalo aquí.
                        </MudText>
                        <textarea id="manual-html-textarea" 
                                  placeholder="Pega el código HTML completo aquí (<html>...)" 
                                  class="w-full p-3 rounded border border-solid mud-border-default mb-2" 
                                  style="width: 100%; min-height: 150px; background: var(--mud-palette-surface); color: var(--mud-palette-text-primary); font-family: 'Courier New', Courier, monospace; font-size: 0.85rem; border-color: var(--mud-palette-divider); outline: none; resize: vertical;"></textarea>
                        <div class="d-flex justify-end">
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="CargarHtmlManual">
                                Procesar y Visualizar HTML
                            </MudButton>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_capturedSelector))
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Text" Class="mt-3 pa-2" Dense="true" Style="border: 1px solid var(--mud-palette-success);">
                        <div class="d-flex flex-column gap-1">
                            <MudText Typo="Typo.subtitle2" Class="font-bold">¡Elemento Capturado!</MudText>
                            <MudText Typo="Typo.body2"><strong>Etiqueta HTML (Tag):</strong> &lt;@(_capturedTagName?.ToUpper())&gt;</MudText>
                            <MudText Typo="Typo.body2"><strong>Texto extraído:</strong> "@_capturedText"</MudText>
                            
                            <!-- Opción de selector a devolver -->
                            <MudRadioGroup T="string" @bind-Value="_selectedOption" Class="d-flex gap-4 mt-1">
                                <MudRadio Value="@("xpath")" Color="Color.Primary" Dense="true">Usar XPath</MudRadio>
                                <MudRadio Value="@("css")" Color="Color.Primary" Dense="true">Usar CSS</MudRadio>
                            </MudRadioGroup>
                            
                            <MudText Typo="Typo.caption" Class="text-muted font-mono mt-1 break-all">
                                <strong>Selector:</strong> @(_selectedOption == "xpath" ? _capturedXpath : _capturedCss)
                            </MudText>
                        </div>
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mt-3 pa-2" Dense="true">
                        Instrucciones: Carga la página de prueba, luego <strong>toca/haz clic directamente sobre el elemento</strong> (ej. el precio) dentro del navegador inferior para capturar su selector.
                    </MudAlert>
                }
            </MudPaper>

            <!-- VISTA DEL NAVEGADOR EMPOTRADO (IFRAME) -->
            <div class="flex-grow-1 border border-solid mud-border-default rounded overflow-hidden relative" style="background: #ffffff; min-height: 50vh;">
                @if (string.IsNullOrEmpty(_proxyUrl))
                {
                    <div class="d-flex flex-column align-center justify-center h-100 py-12 text-center" style="background: var(--mud-palette-background);">
                        <MudIcon Icon="@Icons.Material.Filled.Web" Size="Size.Large" Color="Color.Default" Class="mb-3" />
                        <MudText Typo="Typo.body2" Class="text-muted">Introduce una URL de prueba arriba y presiona "Cargar Vista" o presiona "Pegar HTML" para cargar código manualmente.</MudText>
                    </div>
                }
                else
                {
                    <iframe id="selector-iframe" 
                            name="selector-iframe" 
                            src="@_proxyUrl" 
                            sandbox="allow-scripts allow-forms allow-same-origin"
                            style="width: 100%; height: 100%; border: none; min-height: 50vh;" 
                            @onload="OnIframeLoaded">
                    </iframe>
                }
            </div>

        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="@(string.IsNullOrEmpty(_capturedSelector))" OnClick="ConfirmSelection">
            Confirmar Selección
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] 
    public string InitialUrl { get; set; } = string.Empty;

    [Parameter] 
    public string FieldName { get; set; } = "Selector";

    [Parameter]
    public string? InitialManualHtml { get; set; }

    private string _testUrl = string.Empty;
    private string _proxyUrl = string.Empty;
    private bool _loadingPage = false;
    private bool _showManualHtmlPanel = true;
    
    // Datos de captura
    private string _capturedXpath = string.Empty;
    private string _capturedCss = string.Empty;
    private string _capturedText = string.Empty;
    private string _capturedTagName = string.Empty;
    private string _capturedSelector = string.Empty;
    private string _selectedOption = "xpath"; // Por defecto XPath

    private DotNetObjectReference<SelectorVisualDialog>? _objRef;

    protected override void OnInitialized()
    {
        _testUrl = InitialUrl;
        _objRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _objRef != null)
        {
            // Registrar el escuchador de postMessage en JS
            await JS.InvokeVoidAsync("teocuitlaRegisterMessageListener", _objRef);

            if (!string.IsNullOrWhiteSpace(InitialManualHtml))
            {
                await Task.Delay(250);
                await CargarHtmlManualDirecto(InitialManualHtml);
            }
        }
    }

    private async Task CargarHtmlManualDirecto(string html)
    {
        _loadingPage = true;
        _capturedSelector = string.Empty;
        _showManualHtmlPanel = true;

        _proxyUrl = "about:blank";
        StateHasChanged();

        await Task.Delay(150);

        try
        {
            await JS.InvokeVoidAsync("teocuitlaSubmitManualHtml", html, _testUrl);
            
            // Inyectar opcionalmente en el textarea local en segundo plano para concordancia visual
            await JS.InvokeVoidAsync("eval", "const el = document.getElementById('manual-html-textarea'); if (el) el.value = 'HTML de diagnóstico cargado automáticamente. Ver visor de código para inspección.';");
        }
        catch (Exception ex)
        {
            _loadingPage = false;
            StateHasChanged();
            Snackbar.Add($"Error al inyectar HTML de diagnóstico: {ex.Message}", Severity.Error);
        }
    }

    private System.Threading.CancellationTokenSource? _loadingCts;

    private async void CargarPaginaProxy()
    {
        if (string.IsNullOrWhiteSpace(_testUrl))
        {
            Snackbar.Add("Por favor ingresa una URL válida.", Severity.Warning);
            return;
        }

        _loadingPage = true;
        _capturedSelector = string.Empty;
        
        // Cancelar cualquier tarea de carga previa en ejecución
        _loadingCts?.Cancel();
        _loadingCts?.Dispose();
        _loadingCts = new System.Threading.CancellationTokenSource();
        var token = _loadingCts.Token;
        
        // Apuntar el iframe a nuestro ProxyController
        _proxyUrl = $"/api/proxy?url={Uri.EscapeDataString(_testUrl)}";
        StateHasChanged();

        // Lanzar temporizador de seguridad de 5 segundos para remover spinner
        try
        {
            await Task.Delay(5000, token);
            if (!token.IsCancellationRequested && _loadingPage)
            {
                _loadingPage = false;
                StateHasChanged();
                Snackbar.Add("Carga lista (algunos recursos lentos siguen cargando en segundo plano).", Severity.Info);
            }
        }
        catch (TaskCanceledException)
        {
            // Cancelado normalmente al disparar OnIframeLoaded o recargar
        }
    }

    private void ToggleManualHtmlPanel()
    {
        _showManualHtmlPanel = !_showManualHtmlPanel;
    }

    private async Task CargarHtmlManual()
    {
        _loadingPage = true;
        _capturedSelector = string.Empty;

        // Forzar renderizado del iframe si no estaba activo
        _proxyUrl = "about:blank";
        StateHasChanged();

        // Esperar a que Blazor actualice el DOM y el iframe exista
        await Task.Delay(150);

        try
        {
            // Enviar el HTML y la URL de referencia a través de JS leyendo directamente del DOM
            var exito = await JS.InvokeAsync<bool>("teocuitlaSubmitManualHtmlFromElement", "manual-html-textarea", _testUrl);
            if (exito)
            {
                Snackbar.Add("HTML manual cargado e inyectado correctamente.", Severity.Success);
            }
            else
            {
                _loadingPage = false;
                StateHasChanged();
                Snackbar.Add("Por favor pega el código HTML primero.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            _loadingPage = false;
            StateHasChanged();
            Snackbar.Add($"Error al cargar HTML manual: {ex.Message}", Severity.Error);
        }
    }

    private void OnIframeLoaded()
    {
        // Cancelar el temporizador de seguridad ya que cargó formalmente
        _loadingCts?.Cancel();
        
        if (_loadingPage)
        {
            _loadingPage = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnSelectorSelected(string xpath, string css, string text, string tagName)
    {
        _capturedXpath = xpath;
        _capturedCss = css;
        _capturedText = text;
        _capturedTagName = tagName;
        
        // Actualizar selector capturado
        _capturedSelector = _selectedOption == "xpath" ? _capturedXpath : _capturedCss;
        
        Snackbar.Add($"Elemento <{tagName.ToUpper()}> capturado: \"{text}\"", Severity.Success);
        StateHasChanged();
    }

    private void Cancel() => MudDialog.Cancel();

    private void ConfirmSelection()
    {
        var finalSelector = _selectedOption == "xpath" ? _capturedXpath : _capturedCss;
        MudDialog.Close(DialogResult.Ok(finalSelector));
    }

    public void Dispose()
    {
        // Cancelar y desechar token de cancelación para evitar fugas
        _loadingCts?.Cancel();
        _loadingCts?.Dispose();
        
        // Desregistrar el escuchador global para evitar fugas de memoria
        _ = JS.InvokeVoidAsync("teocuitlaUnregisterMessageListener");
        _objRef?.Dispose();
    }
}
