    private async Task LoadDescuentos()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var rawDescuentos = await context.VariantesComerciales
            .Include(v => v.ProductoMaestro)
            .Include(v => v.CatalogoSitio)
            .Where(v => v.PrecioActual.HasValue && v.PrecioAnterior.HasValue && v.PrecioActual.Value < v.PrecioAnterior.Value)
            .OrderByDescending(v => (v.PrecioAnterior!.Value - v.PrecioActual!.Value) / v.PrecioAnterior!.Value)
            .Take(4)
            .ToListAsync();

        _descuentos = rawDescuentos.Select(v => new DescuentoItem
        {
            Producto = v.ProductoMaestro!,
            Nombre = v.ProductoMaestro!.Nombre,
            SitioNombre = v.CatalogoSitio != null ? v.CatalogoSitio.Nombre : "Tienda",
            PrecioAnterior = v.PrecioAnterior!.Value,
            PrecioActual = v.PrecioActual!.Value,
            ImagenUrl = v.ImagenUrl
        }).ToList();
    }
    private async Task ActualizarPrecioOnline(VarianteComercial v)
    {
        _trackingStates[v.Id] = true;
        StateHasChanged();
        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.DefaultRequestHeaders.Add("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36");
            
            var html = await client.GetStringAsync(v.UrlProducto);
            
            var result = HeuristicExtractor.Extract(html);
            if (result.Precio.HasValue)
            {
                using var context = await DbFactory.CreateDbContextAsync();
                var dbVariante = await context.VariantesComerciales.FindAsync(v.Id);
                if (dbVariante != null)
                {
                    dbVariante.PrecioAnterior = dbVariante.PrecioActual;
                    dbVariante.PrecioActual = result.Precio.Value;
                    dbVariante.EnStock = result.EnStock;
                    if (!string.IsNullOrEmpty(result.ImagenUrl) && string.IsNullOrEmpty(dbVariante.ImagenUrl))
                    {
                        dbVariante.ImagenUrl = result.ImagenUrl;
                    }
                    dbVariante.UltimaActualizacion = DateTime.Now;
                    
                    var hist = new HistorialPrecio
                    {
                        VarianteComercialId = v.Id,
                        Precio = result.Precio.Value,
                        EnStock = result.EnStock,
                        FechaCaptura = DateTime.Now
                    };
                    context.HistorialPrecios.Add(hist);
                    await context.SaveChangesAsync();
                    
                    Snackbar.Add($"Precio actualizado a ${result.Precio.Value:N2} ({v.CatalogoSitio?.Nombre})", Severity.Success);
                    
                    await LoadProductoDetalle();
                    await LoadDescuentos();
                    await LoadProductos();
                }
            }
            else
            {
                Snackbar.Add($"No se pudo extraer el precio automáticamente de {v.CatalogoSitio?.Nombre}.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al conectar o rastrear: {ex.Message}", Severity.Error);
        }
        finally
        {
            _trackingStates[v.Id] = false;
            StateHasChanged();
        }
    }

    private class DescuentoItem
    {
        public ProductoMaestro Producto { get; set; } = null!;
        public string Nombre { get; set; } = string.Empty;
        public string SitioNombre { get; set; } = string.Empty;
        public decimal PrecioAnterior { get; set; }
        public decimal PrecioActual { get; set; }
        public decimal DescuentoPorcentaje => PrecioAnterior > 0 ? ((PrecioAnterior - PrecioActual) / PrecioAnterior) * 100 : 0;
        public string? ImagenUrl { get; set; }
    }
}

