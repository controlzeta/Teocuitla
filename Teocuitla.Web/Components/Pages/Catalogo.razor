@page "/catalogo"
@rendermode InteractiveServer
@inject IDbContextFactory<TeocuitlaDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Catálogo de Productos - Teocuitla</PageTitle>

<!-- WIDGET: OPORTUNIDADES DE DESCUENTO -->
@if (_descuentos.Count > 0)
{
    <MudPaper Outlined="true" Class="pa-4 border border-solid mud-border-default mb-6" Style="background: linear-gradient(135deg, rgba(0, 93, 171, 0.05) 0%, rgba(212, 175, 55, 0.05) 100%);">
        <div class="d-flex align-center gap-2 mb-3">
            <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Class="font-bold" Style="font-family: 'Outfit', sans-serif;">🔥 Oportunidades de Descuento</MudText>
            <MudText Typo="Typo.caption" Class="text-muted d-none d-sm-inline">Artículos de tu catálogo con mayor bajada de precio.</MudText>
        </div>
        <MudGrid Spacing="2">
            @foreach (var item in _descuentos)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Outlined="true" Class="border border-solid mud-border-default h-100 hover-card" Style="background: var(--mud-palette-surface); cursor: pointer;" @onclick="() => OnProductoSelected(item.Producto)">
                        <MudCardContent Class="pa-3">
                            <div class="d-flex align-center gap-3">
                                @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                {
                                    <div class="d-flex align-center justify-center rounded border border-solid mud-border-default" style="width: 50px; height: 50px; background: white; padding: 2px; overflow: hidden; flex-shrink: 0;">
                                        <img src="@item.ImagenUrl" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="Imagen" />
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-center justify-center rounded border border-solid mud-border-default" style="width: 50px; height: 50px; background: var(--mud-palette-background-grey); flex-shrink: 0;">
                                        <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Default" Size="Size.Small" />
                                    </div>
                                }
                                <div style="min-width: 0; flex-grow: 1; text-align: left;">
                                    <div class="d-flex align-center justify-space-between mb-1">
                                        <span class="badge-site" style="font-size: 9px; padding: 1px 4px; background: var(--mud-palette-background-grey); border-radius: 3px;">@item.SitioNombre</span>
                                        <span style="font-weight: bold; color: var(--mud-palette-success); font-size: 10px;">
                                            -@($"{item.DescuentoPorcentaje:F0}%")
                                        </span>
                                    </div>
                                    <MudText Typo="Typo.subtitle2" Class="font-bold truncate-text" Style="max-width: 100%;">@item.Nombre</MudText>
                                    
                                    <div class="d-flex align-center gap-2 mt-1">
                                        <span style="text-decoration: line-through; color: #888888; font-size: 11px;">$@($"{item.PrecioAnterior:N2}")</span>
                                        <span style="font-weight: bold; color: var(--mud-palette-success); font-size: 13px;">$@($"{item.PrecioActual:N2}")</span>
                                    </div>
                                </div>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>
}

<!-- NAVEGACIÓN POR CATEGORÍAS (CATEGORY CHIPS BAR) -->
<div class="mb-4">
    <div class="d-flex align-center justify-space-between mb-2">
        <MudText Typo="Typo.caption" Class="text-muted font-bold d-block">Explorar por Categoría</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="OpenAddProductoDialog">
            Nuevo Producto
        </MudButton>
    </div>
    <div class="category-chips-scroll">
        <MudChip T="string" 
                 Variant="@(string.IsNullOrEmpty(_selectedCategoria) ? Variant.Filled : Variant.Outlined)" 
                 Color="Color.Primary" 
                 OnClick="@(() => OnCategoriaFilterChanged(null))" 
                 Class="category-chip-item font-bold">
            Todas (@_productos.Count)
        </MudChip>
        @foreach (var cat in _categorias)
        {
            var isSel = _selectedCategoria == cat;
            var count = _categoriaCounts.GetValueOrDefault(cat, 0);
            <MudChip T="string" 
                     Variant="@(isSel ? Variant.Filled : Variant.Outlined)" 
                     Color="Color.Primary" 
                     OnClick="@(() => OnCategoriaFilterChanged(cat))" 
                     Class="category-chip-item font-bold">
                @cat (@count)
            </MudChip>
        }
    </div>
</div>

<!-- BARRA DE HERRAMIENTAS DE FILTROS, ORDENAMIENTO Y VISTAS -->
<MudPaper Outlined="true" Class="pa-3 border border-solid mud-border-default mb-4" Style="background: var(--mud-palette-surface);">
    <div class="d-flex align-center justify-space-between flex-wrap gap-3">
        <div class="d-flex align-center gap-2 flex-grow-1" style="min-width: 260px;">
            <MudTextField Value="_searchQuery" 
                          Placeholder="Buscar producto, marca o categoría..." 
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Search" 
                          Immediate="true"
                          ValueChanged="@(async (string s) => await OnSearchChanged(s))"
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense" 
                          Class="flex-grow-1" />
        </div>
        
        <div class="d-flex align-center gap-2 flex-wrap">
            <MudSelect T="int?" Value="_selectedSitioId" ValueChanged="OnSitioFilterChanged" Label="Tienda" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Placeholder="Todas" Style="min-width: 130px;">
                @foreach (var s in _sitios)
                {
                    var count = _sitioCounts.GetValueOrDefault(s.Id, 0);
                    <MudSelectItem Value="@((int?)s.Id)">@($"{s.Nombre} ({count})")</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string" Value="_sortBy" ValueChanged="@(async (string s) => { _sortBy = s; await LoadProductos(); })" Label="Ordenar por" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 160px;">
                <MudSelectItem Value='@("nombre")'>Nombre (A-Z)</MudSelectItem>
                <MudSelectItem Value='@("descuento")'>Mayor Descuento (%)</MudSelectItem>
                <MudSelectItem Value='@("precio_asc")'>Precio: Menor a Mayor</MudSelectItem>
                <MudSelectItem Value='@("precio_desc")'>Precio: Mayor a Menor</MudSelectItem>
            </MudSelect>

            <div class="d-flex align-center gap-1 border border-solid mud-border-default rounded pa-1" style="background: var(--mud-palette-background-grey);">
                <MudIconButton Icon="@Icons.Material.Filled.GridView" Color="@(_isGridView ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="@(() => _isGridView = true)" Tooltip="Vista en Cuadrícula" />
                <MudIconButton Icon="@Icons.Material.Filled.ViewList" Color="@(!_isGridView ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="@(() => _isGridView = false)" Tooltip="Vista en Lista" />
            </div>
        </div>
    </div>

    <!-- FILTROS RÁPIDOS TOGGLES -->
    <div class="d-flex align-center gap-2 mt-2 pt-2 border-t border-solid mud-border-default">
        <MudChip T="bool" Variant="@(_filterSoloOfertas ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(async () => { _filterSoloOfertas = !_filterSoloOfertas; await LoadProductos(); })" Size="Size.Small" Class="font-bold">
            🔥 Solo con Descuento
        </MudChip>
        <MudChip T="bool" Variant="@(_filterSoloStock ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(async () => { _filterSoloStock = !_filterSoloStock; await LoadProductos(); })" Size="Size.Small" Class="font-bold">
            📦 Solo en Stock
        </MudChip>
    </div>
</MudPaper>

<MudGrid>
    <!-- VISTA DE PRODUCTOS (GRID / LISTA) -->
    <MudItem xs="12" md="5" Class="@(_showDetails ? "mobile-hide-list" : "d-block")">
        @if (_loadingProductos)
        {
            <div class="d-flex justify-center my-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_productos.Count == 0)
        {
            <MudPaper Outlined="true" Class="pa-8 text-center border border-solid mud-border-default" Style="background: var(--mud-palette-surface);">
                <MudText Typo="Typo.body2" Class="text-muted">No se encontraron productos con los filtros aplicados.</MudText>
            </MudPaper>
        }
        else if (_isGridView)
        {
            <!-- VISTA CUADRÍCULA (GRID CARDS) -->
            <MudGrid Spacing="2">
                @foreach (var prod in _productos)
                {
                    var firstImgUrl = prod.Variantes.FirstOrDefault(v => !string.IsNullOrEmpty(v.ImagenUrl))?.ImagenUrl;
                    var minPrecio = prod.Variantes.Where(v => v.PrecioActual.HasValue).Select(v => v.PrecioActual!.Value).DefaultIfEmpty(0).Min();
                    var maxDescuentoPct = prod.Variantes.Select(v => (v.PrecioAnterior.HasValue && v.PrecioAnterior > v.PrecioActual && v.PrecioActual.HasValue) ? (double)((v.PrecioAnterior.Value - v.PrecioActual.Value) / v.PrecioAnterior.Value) * 100 : 0).DefaultIfEmpty(0).Max();
                    var isSelected = _selectedProducto?.Id == prod.Id;

                    <MudItem xs="12" sm="6">
                        <MudCard Outlined="true" 
                                 Class='@($"border border-solid mud-border-default h-100 product-grid-card {(isSelected ? "selected-product-item" : "")}")' 
                                 Style="background: var(--mud-palette-surface);"
                                 @onclick="@(() => OnProductoSelected(prod))">
                            <MudCardContent Class="pa-3">
                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex justify-space-between align-start">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="font-bold pa-0 ma-0" Style="font-size: 0.65rem;">
                                            @prod.Categoria
                                        </MudChip>
                                        @if (maxDescuentoPct > 0)
                                        {
                                            <span style="font-weight: bold; color: var(--mud-palette-success); font-size: 0.7rem; background: rgba(16, 185, 129, 0.15); padding: 1px 6px; border-radius: 4px;">
                                                -@($"{maxDescuentoPct:F0}%")
                                            </span>
                                        }
                                    </div>
                                    
                                    <div class="d-flex align-center gap-3">
                                        @if (!string.IsNullOrEmpty(firstImgUrl))
                                        {
                                            <div class="d-flex align-center justify-center rounded border border-solid mud-border-default pa-1" style="width: 54px; height: 54px; background: white; flex-shrink: 0; overflow: hidden;">
                                                <img src="@firstImgUrl" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="Imagen" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-center justify-center rounded border border-solid mud-border-default pa-1" style="width: 54px; height: 54px; background: var(--mud-palette-background-grey); flex-shrink: 0;">
                                                <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Default" Size="Size.Small" />
                                            </div>
                                        }
                                        
                                        <div style="min-width: 0; flex-grow: 1;">
                                            <MudText Typo="Typo.subtitle2" Class="font-bold truncate-text">@prod.Nombre</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted d-block truncate-text">@prod.Marca</MudText>
                                            
                                            <div class="d-flex align-center justify-space-between mt-1">
                                                <MudText Typo="Typo.subtitle2" Class="font-bold text-success">
                                                    @(minPrecio > 0 ? $"${minPrecio:N2}" : "Sin precio")
                                                </MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted font-bold" Style="font-size: 0.65rem;">
                                                    @prod.Variantes.Count tienda(s)
                                                </MudText>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <!-- VISTA LISTA COMPACTA -->
            <MudList T="ProductoMaestro" SelectedValue="_selectedProducto" SelectedValueChanged="OnProductoSelected" Color="Color.Primary" Class="border border-solid mud-border-default rounded" Style="background: var(--mud-palette-surface); padding: 0;">
                @foreach (var prod in _productos)
                {
                    var firstImgUrl = prod.Variantes.FirstOrDefault(v => !string.IsNullOrEmpty(v.ImagenUrl))?.ImagenUrl;
                    var isSelected = _selectedProducto?.Id == prod.Id;
                    <MudListItem Value="prod" Class="@(isSelected ? "selected-product-item border-b border-solid mud-border-default py-2" : "border-b border-solid mud-border-default py-2")">
                        <div class="d-flex align-center justify-space-between w-100">
                            <div class="d-flex align-center gap-3" style="min-width: 0;">
                                @if (!string.IsNullOrEmpty(firstImgUrl))
                                {
                                    <div class="d-flex align-center justify-center rounded border border-solid mud-border-default" style="width: 44px; height: 44px; background: white; padding: 2px; overflow: hidden; flex-shrink: 0;">
                                        <img src="@firstImgUrl" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="Imagen" />
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-center justify-center rounded border border-solid mud-border-default" style="width: 44px; height: 44px; background: var(--mud-palette-background-grey); flex-shrink: 0;">
                                        <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Default" Size="Size.Small" />
                                    </div>
                                }
                                <div style="min-width: 0; text-align: left;">
                                    <MudText Typo="Typo.subtitle2" Class="font-bold truncate-text" Style="max-width: 180px;">@prod.Nombre</MudText>
                                    <div class="d-flex align-center gap-2">
                                        <MudText Typo="Typo.caption" Class="text-muted">@prod.Marca</MudText>
                                        <span class="text-muted" style="font-size: 8px;">•</span>
                                        <MudText Typo="Typo.caption" Class="text-primary truncate-text" Style="max-width: 100px;">@prod.Categoria</MudText>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex align-center gap-1">
                                <span @onclick:stopPropagation="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                   Color="Color.Error" 
                                                   Size="Size.Small" 
                                                   Title="Eliminar Producto"
                                                   OnClick="@(() => DeleteProducto(prod))" />
                                </span>
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" Size="Size.Small" />
                            </div>
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
    </MudItem>


    <!-- DETALLE DEL PRODUCTO SELECCIONADO -->
    <MudItem xs="12" md="7" Class="@(!_showDetails ? "mobile-hide-details" : "d-block")">
        @if (_selectedProducto == null)
        {
            <div class="d-flex flex-column align-center justify-center h-100 text-center py-12 border border-solid mud-border-default rounded" Style="background: var(--mud-palette-surface); min-height: 400px;">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Large" Color="Color.Default" Class="mb-4" Style="font-size: 3rem;" />
                <MudText Typo="Typo.h6" Class="font-bold">Selecciona un producto</MudText>
                <MudText Typo="Typo.body2" Class="text-muted max-w-xs">Elige un producto de la lista para ver su comparativa de precios, histórico y enlaces comerciales.</MudText>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-4 h-100">
                <!-- Encabezado Detalle -->
                <div class="d-flex align-center gap-2">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="RegresarALista" Class="mr-2 d-md-none" />
                    <div>
                        <MudText Typo="Typo.h5" Class="font-bold" Style="font-family: 'Outfit', sans-serif;">@_selectedProducto.Nombre</MudText>
                        <MudText Typo="Typo.caption" Class="text-muted">@_selectedProducto.Marca • @_selectedProducto.Categoria</MudText>
                    </div>
                    <MudSpacer />
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="OpenAddVarianteDialog">Agregar Variante</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="DeleteSelectedProducto">Eliminar Producto</MudMenuItem>
                    </MudMenu>
                </div>

                <!-- RESUMEN DE ANALÍTICA DEL PRODUCTO MAESTRO -->
                @if (_variantes.Any(v => v.PrecioActual.HasValue))
                {
                    var precios = _variantes.Where(v => v.PrecioActual.HasValue).Select(v => (double)v.PrecioActual!.Value).ToList();
                    var minPrecio = precios.Min();
                    var maxPrecio = precios.Max();
                    var avgPrecio = precios.Average();
                    var mejorVariante = _variantes.Where(v => v.PrecioActual.HasValue).OrderBy(v => v.PrecioActual).FirstOrDefault();
                    var ahorroMax = maxPrecio - minPrecio;
                    var ahorroPct = maxPrecio > 0 ? (ahorroMax / maxPrecio) * 100 : 0;
                    
                    <MudPaper Outlined="true" Class="pa-4 border border-solid mud-border-default mb-2" Style="background: var(--mud-palette-surface);">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-4">
                            <div class="d-flex align-center gap-3">
                                <div class="rounded pa-2" style="background: rgba(16, 185, 129, 0.15);">
                                    <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Color="Color.Success" Size="Size.Medium" />
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Class="text-muted d-block">Mejor Opción Actual</MudText>
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mud-text-success">
                                        $@minPrecio.ToString("N2") <span style="font-size: 0.75rem;" class="text-muted">(@(mejorVariante?.CatalogoSitio?.Nombre ?? "Tienda"))</span>
                                    </MudText>
                                </div>
                            </div>
                            
                            <div class="d-flex align-center gap-6 flex-wrap">
                                <div>
                                    <MudText Typo="Typo.caption" Class="text-muted d-block">Precio Máximo</MudText>
                                    <MudText Typo="Typo.subtitle2" Class="font-bold">$@maxPrecio.ToString("N2")</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Class="text-muted d-block">Precio Promedio</MudText>
                                    <MudText Typo="Typo.subtitle2" Class="font-bold">$@avgPrecio.ToString("N2")</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Class="text-muted d-block">Ahorro Máx. Entre Tiendas</MudText>
                                    <MudText Typo="Typo.subtitle2" Class="font-bold text-info">
                                        $@ahorroMax.ToString("N2") (@ahorroPct.ToString("F0")%)
                                    </MudText>
                                </div>
                            </div>
                        </div>
                    </MudPaper>
                }

                <!-- CARDS DE VARIANTES (SITIOS COMPARADOS) -->
                <MudText Typo="Typo.subtitle2" Class="font-bold mt-2" Style="font-family: 'Outfit', sans-serif;">Precios Actuales por Tienda</MudText>

                @if (_variantes.Count == 0)
                {
                    <MudPaper Outlined="true" Class="pa-6 text-center border border-solid mud-border-default" Style="background: var(--mud-palette-surface);">
                        <MudText Typo="Typo.body2" Class="text-muted mb-4">Este producto no tiene enlaces comerciales registrados.</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="OpenAddVarianteDialog">
                            Vincular Tienda / Enlace
                        </MudButton>
                    </MudPaper>
                }
                else
                {
                    <MudGrid Spacing="2">
                        @foreach (var v in _variantes)
                        {
                            <MudItem xs="12" sm="6">
                                <MudCard Outlined="true" Class="border border-solid mud-border-default h-100" Style="background: var(--mud-palette-surface);">
                                    <MudCardHeader Class="py-2 px-3">
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.subtitle2" Class="font-bold text-primary">@(v.CatalogoSitio?.Nombre ?? "Tienda")</MudText>
                                            <MudText Typo="Typo.body2" Class="font-medium truncate-text d-block my-1" Style="max-width: 220px;" title="@v.Nombre">@v.Nombre</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted truncate-text d-block" Style="max-width: 220px;">SKU: @v.Sku</MudText>
                                        </CardHeaderContent>
                                        <CardHeaderActions>
                                            @if (!v.Activo)
                                            {
                                                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Text" Class="font-bold">Inactivo</MudChip>
                                            }
                                            else if (_variantFallaIds.ContainsKey(v.Id))
                                            {
                                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Class="font-bold">Error Rastreo</MudChip>
                                            }
                                            else if (v.EnStock)
                                            {
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text" Class="font-bold">Stock</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Text" Class="font-bold">Agotado</MudChip>
                                            }
                                        </CardHeaderActions>
                                    </MudCardHeader>
                                    <MudCardContent Class="py-2 px-3">
                                        <div class="d-flex gap-3 align-center">
                                            @if (!string.IsNullOrWhiteSpace(v.ImagenUrl))
                                            {
                                                <div class="d-flex align-center justify-center rounded border border-solid mud-border-default cursor-pointer" 
                                                     style="width: 70px; height: 70px; background: white; padding: 4px; overflow: hidden; flex-shrink: 0;"
                                                     @onclick="@(() => OpenImageUploadDialog(v))"
                                                     title="Ver/Cambiar imagen">
                                                    <img src="@v.ImagenUrl" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="Imagen de producto" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-center justify-center rounded border border-dashed mud-border-default cursor-pointer" 
                                                     style="width: 70px; height: 70px; background: var(--mud-palette-background-grey); flex-shrink: 0;"
                                                     @onclick="@(() => OpenImageUploadDialog(v))"
                                                     title="Cargar imagen manualmente">
                                                    <MudIcon Icon="@Icons.Material.Filled.AddAPhoto" Color="Color.Primary" Size="Size.Medium" />
                                                </div>
                                            }
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-end justify-space-between">
                                                    <div>
                                                        <MudText Typo="Typo.caption" Class="text-muted d-block">Precio Actual</MudText>
                                                        <MudText Typo="Typo.h5" Class="font-bold text-primary">
                                                            @(v.PrecioActual.HasValue ? $"${v.PrecioActual:N2}" : "Sin datos")
                                                        </MudText>
                                                    </div>
                                                    @if (v.PrecioActual.HasValue && v.PrecioAnterior.HasValue)
                                                    {
                                                        var diff = v.PrecioActual.Value - v.PrecioAnterior.Value;
                                                        <div class="text-right">
                                                            @if (diff < 0)
                                                            {
                                                                <span class="mud-text-success font-bold d-flex align-center gap-1">
                                                                    <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" /> @($"${Math.Abs(diff):N2}")
                                                                </span>
                                                            }
                                                            else if (diff > 0)
                                                            {
                                                                <span class="mud-text-error font-bold d-flex align-center gap-1">
                                                                    <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" /> @($"${diff:N2}")
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">Sin cambio</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </MudCardContent>
                                    <MudCardActions Class="py-1 px-3 border-t border-solid mud-border-default justify-space-between">
                                        <div class="d-flex gap-1 align-center">
                                            <MudIconButton Icon="@Icons.Material.Filled.Launch" Size="Size.Small" Color="Color.Primary" Href="@v.UrlProducto" Target="_blank" Tooltip="Abrir en Tienda" />
                                            @if (_trackingStates.GetValueOrDefault(v.Id))
                                            {
                                                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" Class="mx-2" />
                                            }
                                            else
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Success" Tooltip="Rastrear y Actualizar Ahora" OnClick="@(() => ActualizarPrecioOnline(v))" />
                                            }
                                            @if (v.Activo && _variantFallaIds.TryGetValue(v.Id, out var fallaId))
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.BugReport" Size="Size.Small" Color="Color.Warning" Tooltip="Diagnosticar Falla" OnClick="@(() => DiagnosticarFalla(fallaId))" />
                                            }
                                        </div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteVariante(v))" />
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>

                    <!-- GRÁFICA DE HISTORIAL DE PRECIOS -->
                    <MudPaper Outlined="true" Class="pa-4 border border-solid mud-border-default mt-4" Style="background: var(--mud-palette-surface);">
                        <MudText Typo="Typo.subtitle2" Class="font-bold mb-3" Style="font-family: 'Outfit', sans-serif;">Evolución de Precios</MudText>
                        
                        @if (_chartSeries.Count == 0)
                        {
                            <div class="d-flex justify-center align-center py-12">
                                <MudText Typo="Typo.body2" Class="text-muted">Capturando historial de precios... Gráfica disponible al registrar capturas.</MudText>
                            </div>
                        }
                        else
                        {
                            <div style="width: 100%; height: 280px; position: relative;">
                                <canvas id="priceEvolutionChart"></canvas>
                            </div>
                        }
                    </MudPaper>
                }
            </div>
        }
    </MudItem>
</MudGrid>

<!-- DIALOG INLINE PARA AGREGAR PRODUCTO -->
<MudDialog @bind-Visible="_addProductoOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-bold">Nuevo Producto Maestro</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_productForm" @bind-IsValid="_productFormIsValid">
            <div class="d-flex flex-column gap-3">
                <MudTextField @bind-Value="_newProducto.Nombre" Label="Nombre del Producto" Required="true" RequiredError="El nombre es obligatorio" Variant="Variant.Outlined" />
                <MudGrid>
                    <MudItem xs="6">
                        <MudTextField @bind-Value="_newProducto.Marca" Label="Marca" Required="true" RequiredError="La marca es obligatoria" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTextField @bind-Value="_newProducto.Categoria" Label="Categoría" Required="true" RequiredError="La categoría es obligatoria" Variant="Variant.Outlined" />
