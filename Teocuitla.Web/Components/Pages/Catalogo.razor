</MudDialog>

<!-- DIALOG PARA CARGAR / VER IMAGEN DE VARIANTE -->
<MudDialog @bind-Visible="_imageUploadOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-bold">Visor e Ingesta de Imagen</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4 align-center justify-center">
            @if (_editingVariante != null)
            {
                <MudText Typo="Typo.subtitle2" Class="text-center font-bold">
                    @(string.IsNullOrEmpty(_editingVariante.Nombre) ? $"SKU {_editingVariante.Sku}" : _editingVariante.Nombre)
                </MudText>
                <MudText Typo="Typo.caption" Class="text-muted text-center" Style="margin-top: -8px;">
                    Portal: @(_editingVariante.CatalogoSitio?.Nombre ?? "Desconocido")
                </MudText>

                <!-- Vista previa de imagen actual -->
                @if (!string.IsNullOrEmpty(_editingVariante.ImagenUrl))
                {
                    <div class="d-flex align-center justify-center rounded border border-solid mud-border-default pa-2" 
                         style="width: 150px; height: 150px; background: white; overflow: hidden;">
                        <img src="@_editingVariante.ImagenUrl" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="Vista previa" />
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column align-center justify-center rounded border border-dashed mud-border-default" 
                         style="width: 150px; height: 150px; background: var(--mud-palette-background-grey);">
                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Default" />
                        <MudText Typo="Typo.caption" Class="text-muted mt-2">Sin imagen asignada</MudText>
                    </div>
                }

                <div class="w-100 mt-2">
                    <MudTabs Elevation="0" Rounded="true" Outlined="true" Centered="true">
                        <MudTabPanel Text="URL de Imagen">
                            <div class="d-flex flex-column gap-3 pa-4">
                                <MudTextField @bind-Value="_newImageUrl" 
                                              Label="Pegar URL de la Imagen" 
                                              Placeholder="https://ejemplo.com/imagen.jpg" 
                                              Variant="Variant.Outlined" 
                                              Adornment="Adornment.End" 
                                              AdornmentIcon="@Icons.Material.Filled.Link" />
                            </div>
                        </MudTabPanel>
                        <MudTabPanel Text="Subir Archivo">
                            <div class="d-flex flex-column align-center gap-3 pa-4">
                                <InputFile OnChange="UploadFile" accept=".jpg,.jpeg,.png,.webp" style="display: none;" id="fileInput" />
                                <MudButton HtmlTag="label"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           for="fileInput">
                                    Seleccionar Imagen
                                </MudButton>
                                @if (_uploadedFile != null)
                                {
                                    <MudText Typo="Typo.caption" Class="text-success font-bold">
                                        📄 @_uploadedFile.Name (@((_uploadedFile.Size / 1024.0).ToString("F1")) KB)
                                    </MudText>
                                }
                            </div>
                        </MudTabPanel>
                    </MudTabs>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseImageUploadDialog">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveImageUpload" Disabled="@(string.IsNullOrEmpty(_newImageUrl) && _uploadedFile == null)">Guardar Imagen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? UrlSearch { get; set; }

    private List<ProductoMaestro> _productos = new();
    private List<CatalogoSitio> _sitios = new();
    private List<string> _categorias = new();
    private List<DescuentoItem> _descuentos = new();
    private bool _loadingProductos = true;
    private string _searchQuery = string.Empty;
    private int? _selectedSitioId;
    private string? _selectedCategoria;

    // Rediseño: Vistas y Ordenamiento
    private bool _isGridView = true;
    private string _sortBy = "nombre"; // "nombre", "descuento", "precio_asc", "precio_desc"
    private bool _filterSoloOfertas = false;
    private bool _filterSoloStock = false;
    
    private ProductoMaestro? _selectedProducto;
    private List<VarianteComercial> _variantes = new();
    private Dictionary<int, int> _variantFallaIds = new(); // key: VarianteComercialId, value: FallaId
    private bool _showDetails = false;
    private Dictionary<int, bool> _trackingStates = new();
    private Dictionary<int, int> _sitioCounts = new();
    private Dictionary<string, int> _categoriaCounts = new();


    // Gráfica
    private List<ChartSeries<double>> _chartSeries = new();
    private string[] _chartLabels = Array.Empty<string>();
    private readonly ChartOptions _chartOptions = new() { ShowLegend = true };
    private bool _chartNeedsRender = false;

    // Formularios e Inlines
    private bool _addProductoOpen = false;
    private ProductoMaestro _newProducto = new();
    private MudForm _productForm = null!;
    private bool _productFormIsValid;

    private bool _addVarianteOpen = false;
    private VarianteComercial _newVariante = new();
    private MudForm _varianteForm = null!;
    private bool _varianteFormIsValid;

    private bool _imageUploadOpen = false;
    private VarianteComercial? _editingVariante;
    private string _newImageUrl = "";
    private IBrowserFile? _uploadedFile;

    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadSitios();
        await LoadCategorias();
        await LoadDescuentos();
        if (!string.IsNullOrEmpty(UrlSearch))
        {
            _searchQuery = UrlSearch;
        }
        await LoadProductos();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (UrlSearch != null && UrlSearch != _searchQuery)
        {
            _searchQuery = UrlSearch;
            await LoadProductos();
        }
    }

    private async Task LoadCategorias()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        _categorias = await context.ProductosMaestros
            .Select(p => p.Categoria)
            .Where(c => !string.IsNullOrEmpty(c))
            .Distinct()
            .OrderBy(c => c)
            .ToListAsync();
    }

    private async Task LoadProductos()
    {
        _loadingProductos = true;
        using var context = await DbFactory.CreateDbContextAsync();
        
        IQueryable<ProductoMaestro> query = context.ProductosMaestros.Include(p => p.Variantes);
        
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            query = query.Where(p => p.Nombre.Contains(_searchQuery) 
                                  || p.Marca.Contains(_searchQuery) 
                                  || p.Categoria.Contains(_searchQuery)
                                  || p.Variantes.Any(v => v.UrlProducto.Contains(_searchQuery) || v.Sku.Contains(_searchQuery)));
        }

        if (_selectedSitioId.HasValue && _selectedSitioId > 0)
        {
            query = query.Where(p => p.Variantes.Any(v => v.CatalogoSitioId == _selectedSitioId.Value));
        }

        if (!string.IsNullOrWhiteSpace(_selectedCategoria))
        {
            query = query.Where(p => p.Categoria == _selectedCategoria);
        }

        if (_filterSoloOfertas)
        {
            query = query.Where(p => p.Variantes.Any(v => v.PrecioActual != null && v.PrecioAnterior != null && v.PrecioActual < v.PrecioAnterior));
        }

        if (_filterSoloStock)
        {
            query = query.Where(p => p.Variantes.Any(v => v.EnStock));
        }

        var rawList = await query.ToListAsync();

        _productos = _sortBy switch
        {
            "precio_asc" => rawList.OrderBy(p => p.Variantes.Where(v => v.PrecioActual.HasValue).Select(v => (double)v.PrecioActual!.Value).DefaultIfEmpty(double.MaxValue).Min()).ToList(),
            "precio_desc" => rawList.OrderByDescending(p => p.Variantes.Where(v => v.PrecioActual.HasValue).Select(v => (double)v.PrecioActual!.Value).DefaultIfEmpty(0).Min()).ToList(),
            "descuento" => rawList.OrderByDescending(p => p.Variantes.Select(v => (v.PrecioAnterior.HasValue && v.PrecioAnterior > v.PrecioActual && v.PrecioActual.HasValue) ? (double)((v.PrecioAnterior.Value - v.PrecioActual.Value) / v.PrecioAnterior.Value) : 0).DefaultIfEmpty(0).Max()).ToList(),
            _ => rawList.OrderBy(p => p.Nombre).ToList()
        };

        // Calcular conteos para filtros (faceted counts)
        _sitioCounts = _productos
            .SelectMany(p => p.Variantes)
            .GroupBy(v => v.CatalogoSitioId)
            .ToDictionary(g => g.Key, g => g.Count());
            
        _categoriaCounts = _productos
            .GroupBy(p => p.Categoria)
            .ToDictionary(g => g.Key, g => g.Count());

        _loadingProductos = false;
    }


    private async Task LoadSitios()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        _sitios = await context.CatalogoSitios.Where(s => s.Activo).OrderBy(s => s.Nombre).ToListAsync();
    }

    private async Task OnSearchChanged(string query)
    {
        _searchQuery = query;
        await LoadProductos();
    }

    private async Task OnSitioFilterChanged(int? sitioId)
    {
        _selectedSitioId = sitioId;
        await LoadProductos();
    }

    private async Task OnCategoriaFilterChanged(string? categoria)
    {
        _selectedCategoria = categoria;
        await LoadProductos();
    }


    private async Task OnProductoSelected(ProductoMaestro prod)
    {
        _selectedProducto = prod;
        _showDetails = true;
        if (_selectedProducto != null)
        {
            await LoadProductoDetalle();
        }
    }

    private async Task LoadProductoDetalle()
    {
        if (_selectedProducto == null) return;

        using var context = await DbFactory.CreateDbContextAsync();
        _variantes = await context.VariantesComerciales
            .Include(v => v.CatalogoSitio)
            .Where(v => v.ProductoMaestroId == _selectedProducto.Id)
            .ToListAsync();

        // Cargar los IDs de fallas activas para estas variantes
        var varianteIds = _variantes.Select(v => v.Id).ToList();
        if (varianteIds.Count > 0)
        {
            var fallas = await context.RegistroFallasScraping
                .Where(f => varianteIds.Contains(f.VarianteComercialId))
                .Select(f => new { f.VarianteComercialId, f.Id })
                .ToListAsync();
            
            // Tomar el id de falla más reciente para cada variante
            _variantFallaIds = fallas
                .GroupBy(f => f.VarianteComercialId)
                .ToDictionary(g => g.Key, g => g.Max(f => f.Id));
        }
        else
        {
            _variantFallaIds.Clear();
        }

        await LoadChartData(context);
    }

    private async Task LoadChartData(TeocuitlaDbContext context)
    {
        _chartSeries.Clear();
        _chartLabels = Array.Empty<string>();

        // Obtener historial de los últimos 7 registros para las variantes de este producto
        var varianteIds = _variantes.Select(v => v.Id).ToList();
        if (varianteIds.Count == 0) return;

        var historial = await context.HistorialPrecios
            .Where(h => varianteIds.Contains(h.VarianteComercialId))
            .OrderBy(h => h.FechaCaptura)
            .ToListAsync();

        if (historial.Count == 0)
        {
            // Intentar rellenar con el precio actual si no hay histórico aún para graficar un punto de partida
            foreach (var v in _variantes.Where(v => v.PrecioActual.HasValue))
            {
                _chartSeries.Add(new ChartSeries<double>
                {
                    Name = v.CatalogoSitio?.Nombre ?? "Tienda",
                    Data = new double[] { (double)v.PrecioActual!.Value }
                });
            }
            _chartLabels = new string[] { DateTime.Today.ToString("dd/MM/yyyy") };
            _chartNeedsRender = true;
            return;
        }

        // Obtener un conjunto único de fechas para las etiquetas del eje X (últimos 7 días o capturas)
        var fechasUnicas = historial
            .Select(h => h.FechaCaptura.ToString("dd/MM/yyyy"))
            .Distinct()
            .TakeLast(7)
            .ToArray();

        _chartLabels = fechasUnicas;

        foreach (var v in _variantes)
        {
            var historialVariante = historial
                .Where(h => h.VarianteComercialId == v.Id)
                .OrderBy(h => h.FechaCaptura)
                .TakeLast(7)
                .ToList();

            if (historialVariante.Count == 0 && v.PrecioActual.HasValue)
            {
                // Si no hay histórico, poner el actual
                var mockData = new double[fechasUnicas.Length];
                Array.Fill(mockData, (double)v.PrecioActual.Value);
                _chartSeries.Add(new ChartSeries<double> { Name = v.CatalogoSitio?.Nombre ?? "Tienda", Data = mockData });
                continue;
            }

            var dataPoints = new List<double>();
            foreach (var label in fechasUnicas)
            {
                // Buscar el precio más cercano a esa fecha
                var punto = historialVariante.FirstOrDefault(h => h.FechaCaptura.ToString("dd/MM/yyyy") == label);
                if (punto != null)
                {
                    dataPoints.Add((double)punto.Precio);
                }
                else
                {
                    // Si no hay datos en esa fecha exacta, usar el último precio conocido o 0
                    dataPoints.Add(dataPoints.Count > 0 ? dataPoints.Last() : (double)(v.PrecioActual ?? 0));
                }
            }

            _chartSeries.Add(new ChartSeries<double>
            {
                Name = v.CatalogoSitio?.Nombre ?? "Tienda",
                Data = dataPoints.ToArray()
            });
        }
        _chartNeedsRender = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartNeedsRender && _chartSeries.Count > 0)
        {
            _chartNeedsRender = false;
            await JS.InvokeVoidAsync("teocuitlaRenderPriceChart", "priceEvolutionChart", _chartLabels, _chartSeries);
        }
    }

    private void RegresarALista()
    {
        _selectedProducto = null;
        _showDetails = false;
    }

    private void OpenAddProductoDialog()
    {
        _newProducto = new ProductoMaestro();
        _addProductoOpen = true;
    }

    private async Task SaveNewProducto()
    {
        await _productForm.Validate();
        if (!_productFormIsValid) return;

        using var context = await DbFactory.CreateDbContextAsync();
        context.ProductosMaestros.Add(_newProducto);
        await context.SaveChangesAsync();

        Snackbar.Add($"Producto '{_newProducto.Nombre}' creado.", Severity.Success);
        _addProductoOpen = false;
        await LoadProductos();
    }

    private async Task DeleteProducto(ProductoMaestro prod)
    {
        if (prod == null) return;

        bool confirm = await JS.InvokeAsync<bool>("confirm", 
            $"¿Está seguro de eliminar '{prod.Nombre}' y todos sus enlaces asociados?");

        if (confirm)
        {
            using var context = await DbFactory.CreateDbContextAsync();
            
            if (_selectedProducto?.Id == prod.Id)
            {
                _selectedProducto = null;
                _showDetails = false;
            }

            var dbProd = await context.ProductosMaestros.FindAsync(prod.Id);
            if (dbProd != null)
            {
                context.ProductosMaestros.Remove(dbProd);
                await context.SaveChangesAsync();
            }

            Snackbar.Add("Producto eliminado.", Severity.Success);
            await LoadProductos();
        }
    }

    private async Task DeleteSelectedProducto()
    {
        if (_selectedProducto == null) return;
        await DeleteProducto(_selectedProducto);
    }

    private void OpenImageUploadDialog(VarianteComercial v)
    {
        _editingVariante = v;
        _newImageUrl = v.ImagenUrl ?? "";
        _uploadedFile = null;
        _imageUploadOpen = true;
    }

    private void CloseImageUploadDialog()
    {
        _imageUploadOpen = false;
        _editingVariante = null;
        _newImageUrl = "";
        _uploadedFile = null;
    }

    private void UploadFile(InputFileChangeEventArgs e)
    {
        _uploadedFile = e.File;
        _newImageUrl = ""; // Limpiar URL para priorizar archivo subido
    }

    private async Task SaveImageUpload()
    {
        if (_editingVariante == null) return;

        using var context = await DbFactory.CreateDbContextAsync();
        var dbVariante = await context.VariantesComerciales.FindAsync(_editingVariante.Id);
        if (dbVariante == null)
        {
            Snackbar.Add("No se encontró la variante en la base de datos.", Severity.Error);
            return;
        }

        string finalImageUrl = _newImageUrl;

        if (_uploadedFile != null)
        {
            try
            {
                var uploadsFolder = Path.Combine(WebHostEnvironment.WebRootPath, "uploads", "images");
                if (!Directory.Exists(uploadsFolder))
                {
                    Directory.CreateDirectory(uploadsFolder);
                }

                var extension = Path.GetExtension(_uploadedFile.Name);
                var fileName = $"variant_{dbVariante.Id}_{DateTime.Now.Ticks}{extension}";
                var filePath = Path.Combine(uploadsFolder, fileName);

                using (var stream = new FileStream(filePath, FileMode.Create))
                {
                    await _uploadedFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5).CopyToAsync(stream);
                }

                finalImageUrl = $"/uploads/images/{fileName}";
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al guardar el archivo: {ex.Message}", Severity.Error);
                return;
            }
        }

        dbVariante.ImagenUrl = finalImageUrl;
        dbVariante.UltimaActualizacion = DateTime.Now;
        await context.SaveChangesAsync();

        _editingVariante.ImagenUrl = finalImageUrl;
        _editingVariante.UltimaActualizacion = dbVariante.UltimaActualizacion;

        if (_selectedProducto != null)
        {
            var uiVariante = _selectedProducto.Variantes.FirstOrDefault(v => v.Id == _editingVariante.Id);
            if (uiVariante != null)
            {
                uiVariante.ImagenUrl = finalImageUrl;
                uiVariante.UltimaActualizacion = dbVariante.UltimaActualizacion;
            }
        }

        Snackbar.Add("Imagen guardada con éxito.", Severity.Success);
        _imageUploadOpen = false;
        _editingVariante = null;
        _uploadedFile = null;
        _newImageUrl = "";
        
        await LoadProductos();
    }

    private void OpenAddVarianteDialog()
    {
        if (_sitios.Count == 0)
        {
            Snackbar.Add("Primero debes configurar y activar al menos un Sitio en el panel de Sitios.", Severity.Warning);
            return;
        }

        _newVariante = new VarianteComercial
        {
            ProductoMaestroId = _selectedProducto?.Id ?? 0,
            CatalogoSitioId = _sitios.First().Id
        };
        _addVarianteOpen = true;
    }

    private async Task SaveNewVariante()
    {
        await _varianteForm.Validate();
        if (!_varianteFormIsValid) return;

        using var context = await DbFactory.CreateDbContextAsync();

        // 1. Validar si ya existe el mismo SKU en el mismo portal/sitio
        var existeEnMismoSitio = await context.VariantesComerciales
            .AnyAsync(v => v.Sku == _newVariante.Sku && v.CatalogoSitioId == _newVariante.CatalogoSitioId);

        if (existeEnMismoSitio)
        {
            Snackbar.Add("Este SKU ya se encuentra registrado para este mismo portal.", Severity.Error);
            return;
        }

        // 2. Validar si el SKU ya existe en otro Producto Maestro
        var varianteExistente = await context.VariantesComerciales
            .Include(v => v.ProductoMaestro)
            .FirstOrDefaultAsync(v => v.Sku == _newVariante.Sku);

        bool vinculadoAOtro = false;
        if (varianteExistente != null && varianteExistente.ProductoMaestro != null)
        {
            var masterProduct = varianteExistente.ProductoMaestro;
            _newVariante.ProductoMaestroId = masterProduct.Id;
            _selectedProducto = masterProduct; // Cambiar el producto seleccionado actual para visualizarlo al cerrar el diálogo
            vinculadoAOtro = true;
        }

        context.VariantesComerciales.Add(_newVariante);
        await context.SaveChangesAsync();

        // Si se ingresó un precio inicial, crear registro en el historial de forma automática
        if (_newVariante.PrecioActual.HasValue)
        {
            var hist = new HistorialPrecio
            {
                VarianteComercialId = _newVariante.Id,
                Precio = _newVariante.PrecioActual.Value,
                EnStock = _newVariante.EnStock,
                FechaCaptura = DateTime.UtcNow
            };
            context.HistorialPrecios.Add(hist);
            await context.SaveChangesAsync();
        }

        if (vinculadoAOtro)
        {
            Snackbar.Add($"El SKU ya existía. Se vinculó automáticamente al producto maestro '{_selectedProducto?.Nombre}'.", Severity.Info);
        }
        else
        {
            Snackbar.Add("Enlace comercial vinculado con éxito.", Severity.Success);
        }

        _addVarianteOpen = false;
        await LoadProductoDetalle();
        await LoadDescuentos();
        await LoadProductos(); // Recargar el listado de productos para reflejar los cambios
    }

    private async Task DeleteVariante(VarianteComercial variante)
    {
        if (variante == null) return;

        bool confirm = await JS.InvokeAsync<bool>("confirm", 
            $"¿Eliminar el enlace de {variante.CatalogoSitio?.Nombre ?? "esta tienda"}?");

        if (confirm)
        {
            try
            {
                using var context = await DbFactory.CreateDbContextAsync();
                var dbVariante = await context.VariantesComerciales.FindAsync(variante.Id);
                if (dbVariante != null)
                {
                    context.VariantesComerciales.Remove(dbVariante);
                    await context.SaveChangesAsync();
                }

                Snackbar.Add("Enlace eliminado con éxito.", Severity.Success);
                await LoadProductoDetalle();
                await LoadDescuentos();
                await LoadProductos();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al eliminar el enlace: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task DiagnosticarFalla(int fallaId)
    {
        var parameters = new DialogParameters<FallaReviewDialog>
        {
            { x => x.FallaId, fallaId }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<FallaReviewDialog>("Revisión y Corrección de Falla", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadProductoDetalle();
        }
    }

