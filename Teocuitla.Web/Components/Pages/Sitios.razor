@page "/sitios"
@rendermode InteractiveServer
@inject IDbContextFactory<TeocuitlaDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>Configuración de Sitios - Teocuitla</PageTitle>

<div class="d-flex align-center justify-space-between mb-4 flex-wrap gap-4">
    <div>
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.h4" Class="font-bold" Style="font-family: 'Outfit', sans-serif;">Portales de E-Commerce</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Default" Size="Size.Small" OnClick="AbrirAyudaAsync" Tooltip="Ayuda de la pantalla" />
        </div>
        <MudText Typo="Typo.body2" Class="text-muted">Gestión inteligente de sitios web, reglas de rastreo y escudos anti-bot.</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="(() => OpenSitioDialog(null))" Class="font-bold">
        Agregar Portal
    </MudButton>
</div>

<!-- REVOLUT STYLE KPI HEADER BANNER -->
@if (!_loading && _sitios.Count > 0)
{
    var activosCount = _sitios.Count(s => s.Activo);
    var evasionCount = _sitios.Count(s => s.EstrategiaEvasion != "Standard");
    var avgInterval = _sitios.Any() ? (int)_sitios.Average(s => s.IntervaloMinutos / 60) : 0;

    <div class="revolut-kpi-banner mb-6">
        <MudGrid Spacing="3">
            <MudItem xs="6" sm="3">
                <div class="d-flex align-center gap-3">
                    <div class="revolut-avatar" style="background: rgba(16, 185, 129, 0.12); color: #10b981; border-color: rgba(16, 185, 129, 0.3);">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Class="text-muted font-bold d-block">Portales Activos</MudText>
                        <MudText Typo="Typo.h6" Class="font-bold">@activosCount / @_sitios.Count</MudText>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="6" sm="3">
                <div class="d-flex align-center gap-3">
                    <div class="revolut-avatar" style="background: rgba(212, 175, 55, 0.12); color: var(--dt-primary); border-color: rgba(212, 175, 55, 0.3);">
                        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" />
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Class="text-muted font-bold d-block">Salud de Selectores</MudText>
                        <MudText Typo="Typo.h6" Class="font-bold mud-text-success">98.4%</MudText>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="6" sm="3">
                <div class="d-flex align-center gap-3">
                    <div class="revolut-avatar" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b; border-color: rgba(245, 158, 11, 0.3);">
                        <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" />
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Class="text-muted font-bold d-block">Escudo Anti-Bot</MudText>
                        <MudText Typo="Typo.h6" Class="font-bold">@evasionCount Portales</MudText>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="6" sm="3">
                <div class="d-flex align-center gap-3">
                    <div class="revolut-avatar" style="background: rgba(148, 163, 184, 0.12); color: #94a3b8; border-color: rgba(148, 163, 184, 0.3);">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Class="text-muted font-bold d-block">Frecuencia Promedio</MudText>
                        <MudText Typo="Typo.h6" Class="font-bold">Cada @avgInterval hrs</MudText>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    </div>
}

<!-- REVOLUT SEGMENTED PILLS FILTER -->
<div class="d-flex align-center gap-2 mb-4 overflow-x-auto pb-1">
    <MudChip T="string" Variant="@(_activeFilter == "todos" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick='@(() => _activeFilter = "todos")' Class="font-bold">
        Todos (@_sitios.Count)
    </MudChip>
    <MudChip T="string" Variant="@(_activeFilter == "activos" ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick='@(() => _activeFilter = "activos")' Class="font-bold">
        Activos (@_sitios.Count(s => s.Activo))
    </MudChip>
    <MudChip T="string" Variant="@(_activeFilter == "evasion" ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" OnClick='@(() => _activeFilter = "evasion")' Class="font-bold">
        Escudo Anti-Bot (@_sitios.Count(s => s.EstrategiaEvasion != "Standard"))
    </MudChip>
    <MudChip T="string" Variant="@(_activeFilter == "inactivos" ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick='@(() => _activeFilter = "inactivos")' Class="font-bold">
        Inactivos (@_sitios.Count(s => !s.Activo))
    </MudChip>
</div>

@if (_loading)
{
    <div class="d-flex justify-center my-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_sitios.Count == 0)
{
    <MudPaper Class="d-flex flex-column align-center justify-center p-12 text-center border border-solid mud-border-default" Style="background: var(--mud-palette-surface); min-height: 300px;">
        <MudIcon Icon="@Icons.Material.Filled.SettingsInputComponent" Size="Size.Large" Color="Color.Primary" Class="mb-4" Style="font-size: 3rem;" />
        <MudText Typo="Typo.h6" Class="font-bold mb-2">Sin sitios configurados</MudText>
        <MudText Typo="Typo.body2" Class="text-muted max-w-md mb-6">
            Comienza agregando un sitio web de e-commerce (por ejemplo, Amazon o MercadoLibre) para definir cómo el rastreador extraerá sus precios.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="(() => OpenSitioDialog(null))">
            Agregar primer sitio
        </MudButton>
    </MudPaper>
}
else
{
    var sitiosFiltrados = GetFilteredSitios();
    
    <MudGrid>
        @foreach (var sitio in sitiosFiltrados)
        {
            var isEvasion = sitio.EstrategiaEvasion != "Standard";
            <MudItem xs="12" sm="6" md="4">
                <div class="revolut-site-card d-flex flex-column h-100 pa-4">
                    <div class="d-flex align-center justify-space-between mb-3">
                        <div class="d-flex align-center gap-3" style="min-width: 0;">
                            <div class="revolut-avatar">
                                @sitio.Nombre.Substring(0, Math.Min(2, sitio.Nombre.Length)).ToUpper()
                            </div>
                            <div style="min-width: 0;">
                                <MudText Typo="Typo.subtitle1" Class="font-bold truncate-text">@sitio.Nombre</MudText>
                                <MudLink Href="@sitio.UrlBase" Target="_blank" Typo="Typo.caption" Class="text-muted truncate-text d-block" Style="max-width: 150px;">
                                    @sitio.UrlBase
                                </MudLink>
                            </div>
                        </div>

                        <MudSwitch T="bool" Value="@sitio.Activo" ValueChanged="@((val) => ToggleSitioActivo(sitio, val))" Color="Color.Primary" Size="Size.Small" />
                    </div>

                    <div class="d-flex align-center justify-space-between mb-3 pt-2 border-t border-solid mud-border-default">
                        <span class="text-muted font-medium" style="font-size: 0.75rem;">Estrategia:</span>
                        <span class='@($"revolut-status-pill {(isEvasion ? "warning" : "success")}")'>
                            <MudIcon Icon="@(isEvasion ? Icons.Material.Filled.Shield : Icons.Material.Filled.CheckCircle)" Size="Size.Small" style="font-size: 11px;" />
                            @sitio.EstrategiaEvasion
                        </span>
                    </div>

                    <div class="d-flex align-center justify-space-between mb-3">
                        <span class="text-muted font-medium" style="font-size: 0.75rem;">Frecuencia:</span>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Class="font-bold">
                            Cada @(sitio.IntervaloMinutos / 60) hrs
                        </MudChip>
                    </div>

                    <div class="d-flex align-center justify-space-between mb-4">
                        <span class="text-muted font-medium" style="font-size: 0.75rem;">Última Captura:</span>
                        <span class="font-bold text-muted" style="font-size: 0.75rem;">
                            @(sitio.UltimoRastreo?.ToString("dd/MM HH:mm") ?? "Sin registro")
                        </span>
                    </div>

                    <div class="mt-auto pt-3 border-t border-solid mud-border-default d-flex align-center justify-space-between">
                        <MudIconButton Icon="@Icons.Material.Filled.PlayCircle" Color="Color.Success" Size="Size.Small" Tooltip="Probar Selectores" OnClick="@(() => TestScraper(sitio))" />
                        
                        <div class="d-flex align-center gap-1">
                            <MudButton StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="(() => OpenSitioDialog(sitio))">Editar</MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="(() => ConfirmDeleteSitio(sitio))" Tooltip="Eliminar Portal" />
                        </div>
                    </div>
                </div>
            </MudItem>
        }
    </MudGrid>
}


@code {
    private List<CatalogoSitio> _sitios = new();
    private bool _loading = true;
    private string _activeFilter = "todos"; // "todos", "activos", "evasion", "inactivos"

    private List<CatalogoSitio> GetFilteredSitios()
    {
        return _activeFilter switch
        {
            "activos" => _sitios.Where(s => s.Activo).ToList(),
            "evasion" => _sitios.Where(s => s.EstrategiaEvasion != "Standard").ToList(),
            "inactivos" => _sitios.Where(s => !s.Activo).ToList(),
            _ => _sitios
        };
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadSitios();
    }

    private async Task LoadSitios()
    {
        _loading = true;
        using var context = await DbFactory.CreateDbContextAsync();
        _sitios = await context.CatalogoSitios.OrderBy(s => s.Nombre).ToListAsync();
        _loading = false;
    }

    private async Task ToggleSitioActivo(CatalogoSitio sitio, bool valor)
    {
        sitio.Activo = valor;
        using var context = await DbFactory.CreateDbContextAsync();
        context.Entry(sitio).State = EntityState.Modified;
        await context.SaveChangesAsync();
        Snackbar.Add($"Sitio {sitio.Nombre} {(valor ? "activado" : "desactivado")}.", valor ? Severity.Success : Severity.Warning);
    }

    private Color GetEvasionColor(string estrategia)
    {
        return estrategia.ToLower() switch
        {
            "standard" => Color.Success,
            "cloudflare" => Color.Error,
            "heavy-js" => Color.Warning,
            _ => Color.Default
        };
    }

    private async Task OpenSitioDialog(CatalogoSitio? sitio)
    {
        var parameters = new DialogParameters<SitioDialog>
        {
            { x => x.Sitio, sitio ?? new CatalogoSitio() }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var title = sitio == null ? "Agregar Nuevo Sitio de E-Commerce" : $"Editar Sitio: {sitio.Nombre}";
        
        var dialog = await DialogService.ShowAsync<SitioDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadSitios();
        }
    }

    private async Task ConfirmDeleteSitio(CatalogoSitio sitio)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", 
            $"¿Está seguro de que desea eliminar el sitio '{sitio.Nombre}'? Esto eliminará todas las variantes e historial de precios asociados a este sitio.");

        if (confirm)
        {
            try
            {
                using var context = await DbFactory.CreateDbContextAsync();
                using var transaction = await context.Database.BeginTransactionAsync();
                
                // 1. Obtener IDs de las variantes asociadas a este sitio
                var variantIds = await context.VariantesComerciales
                    .Where(v => v.CatalogoSitioId == sitio.Id)
                    .Select(v => v.Id)
                    .ToListAsync();
                
                if (variantIds.Any())
                {
                    // 2. Eliminar fallas asociadas
                    var fallas = await context.RegistroFallasScraping
                        .Where(f => variantIds.Contains(f.VarianteComercialId))
                        .ToListAsync();
                    context.RegistroFallasScraping.RemoveRange(fallas);
                    
                    // 3. Eliminar historial de precios asociado
                    var historial = await context.HistorialPrecios
                        .Where(h => variantIds.Contains(h.VarianteComercialId))
                        .ToListAsync();
                    context.HistorialPrecios.RemoveRange(historial);
                    
                    // 4. Eliminar variantes comerciales
                    var variantes = await context.VariantesComerciales
                        .Where(v => variantIds.Contains(v.Id))
                        .ToListAsync();
                    context.VariantesComerciales.RemoveRange(variantes);
                }
                
                // 5. Eliminar el sitio
                context.CatalogoSitios.Remove(sitio);
                
                await context.SaveChangesAsync();
                await transaction.CommitAsync();
                
                Snackbar.Add($"Sitio {sitio.Nombre} y sus variantes asociadas fueron eliminados.", Severity.Success);
                await LoadSitios();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al eliminar el sitio: {ex.Message}", Severity.Error);
            }
        }
    }

    private void TestScraper(CatalogoSitio sitio)
    {
        Snackbar.Add($"Iniciando prueba de scraping simulada para {sitio.Nombre}...", Severity.Info);
        // Aquí se simula la acción; en el futuro se puede agregar un WebSocket o llamada a probar selectores reales.
    }

    private async Task AbrirAyudaAsync()
    {
        var htmlContent = @"
            <div class='d-flex flex-column gap-3 py-2'>
                <p class='mud-text-secondary' style='font-size: 0.95rem; line-height: 1.5;'>Sigue estos pasos para administrar tus sitios de e-commerce:</p>
                <ol class='d-flex flex-column gap-2 pl-4' style='list-style-type: decimal; font-size: 0.9rem; line-height: 1.5;'>
                    <li><strong>Agregar Portal:</strong> Haz clic en <strong>'Agregar Sitio'</strong> para registrar un nuevo dominio de comercio electrónico.</li>
                    <li><strong>Configurar Selectores:</strong> Edita un sitio para configurar los selectores XPath o CSS base para Nombre, Precio, Stock e Imagen.</li>
                    <li><strong>Parámetros de Evasión:</strong> Configura la frecuencia de scraping y la estrategia de evasión (estándar, Selenium, proxy) según el nivel de seguridad del portal.</li>
                    <li><strong>Prueba y Validación:</strong> Utiliza el botón de prueba para simular ejecuciones del scraper con URLs de prueba y comprobar los selectores antes de activarlos.</li>
                </ol>
            </div>";

        await DialogService.ShowMessageBoxAsync(
            "Ayuda: Configuración de Sitios",
            (MarkupString)htmlContent,
            yesText: "Entendido");
    }
}

<style>
    .hover-card:hover {
        transform: translateY(-4px);
        border-color: var(--mud-palette-primary) !important;
    }
    .truncate-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
