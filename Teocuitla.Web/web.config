<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Para más información sobre la personalización del módulo ASP.NET Core e IIS, visita: https://go.microsoft.com/fwlink/?linkid=838655 -->
  <system.webServer>
    <handlers>
      <remove name="aspNetCore" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
      <handlerSettings>
        <!-- Habilita la copia en sombra (Shadow Copy) para evitar bloqueos de archivos DLL durante la publicación/actualización -->
        <!--<handlerSetting name="enableShadowCopy" value="true" />-->
        <!--<handlerSetting name="shadowCopyDirectory" value="../ShadowCopyDirectory/" />-->
      </handlerSettings>
    </aspNetCore>
  </system.webServer>
</configuration>
